generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

enum QuestionType {
  SINGLE
  MULTI
  SHORT
}

enum GroupMethod {
  BALANCED
  SIMILAR
  AVOID_PREV
}

enum LiveStatus {
  LOBBY
  QUESTION
  REVEAL
  ENDED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(LEARNER)
  email        String?  @unique // 추후 Google 로그인 연동용
  image        String? // 프로필 사진 URL (Google 로그인 시 자동 반영)
  createdAt    DateTime @default(now())

  submissions  Submission[]
  topic        Topic?
  topicLikes   TopicLike[]
  keywordLikes KeywordLike[]
  comments     Comment[]
  groupMembers GroupMember[]
  liveParticipants LiveParticipant[]
  liveAnswers      LiveAnswer[]
  memoEdits        GroupMemo[]        @relation("MemoEditor")
  groupMemoLikes   GroupMemoLike[]
  groupMemoComments GroupMemoComment[]
  topicPicks           TopicPick[]
  researchGroupMembers ResearchGroupMember[]
  attendances          Attendance[]
  researchMemoEdits        ResearchGroupMemo[]        @relation("ResearchMemoEditor")
  researchGroupMemoLikes   ResearchGroupMemoLike[]
  researchGroupMemoComments ResearchGroupMemoComment[]
  qnaQuestions             QnaQuestion[]
  qnaComments              QnaComment[]
  qnaLikes                 QnaLike[]
  guestAnswers             GuestAnswer[]
}

// ── 질문 게시판 ───────────────────────────────────────

model QnaQuestion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  comments QnaComment[]
  likes    QnaLike[]
}

model QnaComment {
  id         String      @id @default(cuid())
  questionId String
  question   QnaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String? // null이면 댓글, 아니면 해당 댓글에 대한 답글 (1단계)
  parent     QnaComment?  @relation("QnaReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies    QnaComment[] @relation("QnaReply")
  content    String
  createdAt  DateTime    @default(now())
}

model QnaLike {
  id         String      @id @default(cuid())
  questionId String
  question   QnaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

// ── 출석 ─────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT // 출석
  ABSENT // 결석
}

model Attendance {
  id        String           @id @default(cuid())
  date      String // YYYY-MM-DD (KST 기준 수업일)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([date, userId])
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  role      Role     @default(LEARNER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Quiz {
  id          String    @id @default(cuid())
  week        Int       @unique
  title       String    @default("")
  description String    @default("")
  timeLimitSec Int?
  markdown    String    @default("")
  publishedAt DateTime?
  openAt      DateTime? // 학습자 공개 시각 — 발행 후에도 null이면 학습자에게 보이지 않음
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions    Question[]
  submissions  Submission[]
  groupSets    GroupSet[]
  liveSessions LiveSession[]
}

model Question {
  id           String       @id @default(cuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order        Int
  type         QuestionType
  text         String
  explanation  String       @default("")
  shortAnswers String[]     @default([])

  options     Option[]
  answers     Answer[]
  liveAnswers LiveAnswer[]

  @@unique([quizId, order])
}

// ── 실시간 퀴즈 세션 ─────────────────────────────────────

model LiveSession {
  id                String     @id @default(cuid())
  quizId            String
  quiz              Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  status            LiveStatus @default(LOBBY)
  currentIndex      Int        @default(0) // 진행 중인 문항 order
  questionStartedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  participants LiveParticipant[]
  answers      LiveAnswer[]
}

model LiveParticipant {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime    @default(now())

  @@unique([sessionId, userId])
}

model LiveAnswer {
  id              String      @id @default(cuid())
  sessionId       String
  session         LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions Int[]       @default([])
  text            String?
  isCorrect       Boolean
  elapsedMs       Int         @default(0) // 문항 공개 후 응답까지 걸린 시간 (동점자 순위용)
  answeredAt      DateTime    @default(now())

  @@unique([sessionId, userId, questionId])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  label      String
  isCorrect  Boolean  @default(false)

  @@unique([questionId, order])
}

model Submission {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt  DateTime @default(now())
  score        Int
  correctCount Int
  total        Int

  answers Answer[]

  @@unique([quizId, userId])
}

model Answer {
  id              String     @id @default(cuid())
  submissionId    String
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions Int[]      @default([]) // 선택한 선지의 order 목록
  text            String?
  isCorrect       Boolean

  @@unique([submissionId, questionId])
}

model GroupSet {
  id          String      @id @default(cuid())
  quizId      String // 기준 주차 퀴즈
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  size        Int
  method      GroupMethod // BALANCED | SIMILAR (AVOID_PREV는 레거시)
  avoidPrev   Boolean     @default(false) // 이전 확정 모둠과 겹침 최소화
  confirmedAt DateTime?
  createdAt   DateTime    @default(now())

  groups Group[]
}

model Group {
  id         String   @id @default(cuid())
  groupSetId String
  groupSet   GroupSet @relation(fields: [groupSetId], references: [id], onDelete: Cascade)
  index      Int

  members      GroupMember[]
  memo         GroupMemo?
  memoLikes    GroupMemoLike[]
  memoComments GroupMemoComment[]

  @@unique([groupSetId, index])
}

model GroupMemoLike {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupMemoComment {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

// 모둠 공유 메모장 (diff 패치 동기화)
model GroupMemo {
  id          String   @id @default(cuid())
  groupId     String   @unique
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  content     String   @default("")
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("MemoEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Topic {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  markdown  String   @default("")
  keywords  String[] @default([])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  likes    TopicLike[]
  comments Comment[]
  picks          TopicPick[]
  researchGroups ResearchGroup[]
}

// ── 자율연구 모둠 (관심 주제 1~5순위 기반) ─────────────────

// 학습자가 동료의 연구 주제 카드에 매긴 관심 순위 (1 = 가장 관심)
model TopicPick {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  rank    Int

  @@unique([userId, topicId])
  @@unique([userId, rank])
}

model ResearchGroupSet {
  id          String    @id @default(cuid())
  groupCount  Int
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  groups ResearchGroup[]
}

model ResearchGroup {
  id      String           @id @default(cuid())
  setId   String
  set     ResearchGroupSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  index   Int
  topicId String // 이 모둠의 앵커 연구 주제
  topic   Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  customTopic String? // 모둠원·관리자가 직접 설정한 연구 주제 (null이면 앵커 주제 제목 표시)

  members      ResearchGroupMember[]
  memo         ResearchGroupMemo?
  memoLikes    ResearchGroupMemoLike[]
  memoComments ResearchGroupMemoComment[]

  showcaseLinks  ShowcaseLink[]
  guestQuestions GuestQuestion[]

  @@unique([setId, index])
}

// ── 결과보고회 ─────────────────────────────────────────

// 게스트 접근 토큰 (단일 행) — 관리자가 발급한 /guest/[token] 링크로만 게스트 접근 허용
model ShowcaseAccess {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
}

// 모둠별 최종 발표 자료 링크
model ShowcaseLink {
  id        String        @id @default(cuid())
  groupId   String
  group     ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime      @default(now())
}

// 게스트가 로그인 없이 남기는 질문 (/guest 공개 페이지)
model GuestQuestion {
  id        String        @id @default(cuid())
  groupId   String
  group     ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guestName String
  content   String
  createdAt DateTime      @default(now())
  answers   GuestAnswer[]
}

// 게스트 질문에 대한 학습자(모둠원)·관리자의 답변
model GuestAnswer {
  id         String        @id @default(cuid())
  questionId String
  question   GuestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime      @default(now())
}

// 자율연구 모둠 공유 메모장 (diff 패치 동기화 — 스터디 메모장과 동일 방식)
model ResearchGroupMemo {
  id          String        @id @default(cuid())
  groupId     String        @unique
  group       ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  content     String        @default("")
  version     Int           @default(0)
  updatedAt   DateTime      @updatedAt
  updatedById String?
  updatedBy   User?         @relation("ResearchMemoEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

model ResearchGroupMemoLike {
  id      String        @id @default(cuid())
  groupId String
  group   ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model ResearchGroupMemoComment {
  id        String        @id @default(cuid())
  groupId   String
  group     ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime      @default(now())
}

model ResearchGroupMember {
  id      String        @id @default(cuid())
  groupId String
  group   ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank    Int? // 배정된 주제에 대한 본인의 선호 순위 (null = 선호 목록에 없던 주제)

  @@unique([groupId, userId])
}

model TopicLike {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
}

model KeywordLike {
  id      String @id @default(cuid())
  keyword String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyword, userId])
}

model Comment {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}
